# Runtime artifacts
runs/**
!runs/.gitkeep

# Python bytecode
__pycache__/
**/__pycache__/
*.py[cod]

# Local temp/work directories
.tmp/**
!.tmp/.gitkeep
.venv/
.pytest_cache/
node_modules/
*.egg-info/
coverage/
htmlcov/
*.coverage
*.log
logs/
build/
dist/
.continuum/
.codex/
.vscode/
site/
tests_tmp/

# Local signing private keys; public verification keys may be committed deliberately.
continuum_private.key
*.private.key
*.private.pem
