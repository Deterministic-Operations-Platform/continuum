{
  "name": "continuum",
  "version": "1.0.0",
  "description": "Continuum is a deterministic, plugin-based Python orchestration engine for high-stakes workflow scenarios (for example FedNow), with audit-ready evidence produced on every run, including failures.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "deck": "node tools/make_deck.js",
    "audit:runtime": "npm audit --omit=dev --audit-level=high"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deterministic-Operations-Platform/continuum.git"
  },
